	(text "Without VBUS the FT4232H is held in reset (R803 / R804, DS_FT4232H fig. 6.3).\nEEPROM: self-powered; program_ftdi writes it (channel A = JTAG for Vivado).\nChannel B must keep RI# on BDBUS7 (not TXDEN): that pin closes the I2C switch."
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "21b091e2-df32-5822-9336-b7dca000fdde")
	)
