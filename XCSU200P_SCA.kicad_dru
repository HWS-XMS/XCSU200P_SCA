(version 1)

# Generated by tools/pcbgen/rules.py: JLCPCB, 6 layers, JLC06161H-3313. Edit there.

(rule "50OHM outer"
  (layer outer)
  (condition "A.hasNetclass('50OHM')")
  (constraint track_width (min 0.151mm) (opt 0.151mm) (max 0.151mm)))

(rule "50OHM inner"
  (layer inner)
  (condition "A.hasNetclass('50OHM')")
  (constraint track_width (min 0.142mm) (opt 0.142mm) (max 0.142mm)))

(rule "90OHM_DIFF outer"
  (layer outer)
  (condition "A.hasNetclass('90OHM_DIFF')")
  (constraint track_width (min 0.154mm) (opt 0.154mm) (max 0.154mm))
  (constraint diff_pair_gap (min 0.203mm) (opt 0.203mm) (max 0.203mm)))

(rule "90OHM_DIFF inner"
  (layer inner)
  (condition "A.hasNetclass('90OHM_DIFF')")
  (constraint track_width (min 0.142mm) (opt 0.142mm) (max 0.142mm))
  (constraint diff_pair_gap (min 0.203mm) (opt 0.203mm) (max 0.203mm)))

(rule "100OHM_DIFF outer"
  (layer outer)
  (condition "A.hasNetclass('100OHM_DIFF')")
  (constraint track_width (min 0.119mm) (opt 0.119mm) (max 0.119mm))
  (constraint diff_pair_gap (min 0.203mm) (opt 0.203mm) (max 0.203mm)))

(rule "100OHM_DIFF inner"
  (layer inner)
  (condition "A.hasNetclass('100OHM_DIFF')")
  (constraint track_width (min 0.11mm) (opt 0.11mm) (max 0.11mm))
  (constraint diff_pair_gap (min 0.203mm) (opt 0.203mm) (max 0.203mm)))

# Synchronous FIFO at 60 MHz: keep the bus short; 10 mm of track are about 70 ps
(rule "FIFO bus length"
  (condition "A.NetName == '*/FIFO_*'")
  (constraint length (max 60mm)))

# Differential pairs: both halves equally long, coupled except at the pins
(rule "USB pair"
  (condition "A.hasNetclass('90OHM_DIFF')")
  (constraint skew (max 0.5mm) (within_diff_pairs))
  (constraint diff_pair_uncoupled (max 6mm)))

(rule "LVDS pair"
  (condition "A.hasNetclass('100OHM_DIFF')")
  (constraint skew (max 0.3mm) (within_diff_pairs))
  (constraint diff_pair_uncoupled (max 6mm)))

# Supply nets routed as tracks: least width by current (rules.py, POWER_TRACKS), outer layers only.
# Narrower only in the rule areas NECK at narrow pads.
(rule "PWR_3A width"
  (condition "A.hasNetclass('PWR_3A') && !A.enclosedByArea('NECK')")
  (constraint track_width (min 1.4mm)))

(rule "PWR_1A5 width"
  (condition "A.hasNetclass('PWR_1A5') && !A.enclosedByArea('NECK')")
  (constraint track_width (min 0.55mm)))

(rule "PWR_1A width"
  (condition "A.hasNetclass('PWR_1A') && !A.enclosedByArea('NECK')")
  (constraint track_width (min 0.3mm)))

(rule "PWR_12V width"
  (condition "A.hasNetclass('PWR_12V') && !A.enclosedByArea('NECK')")
  (constraint track_width (min 0.9mm)))

(rule "supply tracks on outer layers"
  (layer inner)
  (condition "A.Type == 'Track' && (A.hasNetclass('PWR_3A') || A.hasNetclass('PWR_1A5') || A.hasNetclass('PWR_1A') || A.hasNetclass('PWR_12V'))")
  (constraint disallow track))

(rule "lens zone: no tall part (1)"
  (condition "A.Type == 'Footprint' && A.intersectsArea('LENS_ZONE') && (A.Reference == 'C201' || A.Reference == 'J1001' || A.Reference == 'J1002' || A.Reference == 'J1101' || A.Reference == 'J1201' || A.Reference == 'J1301' || A.Reference == 'J1501' || A.Reference == 'J1502' || A.Reference == 'J201' || A.Reference == 'J401' || A.Reference == 'J402' || A.Reference == 'J403')")
  (constraint disallow footprint))

(rule "lens zone: no tall part (2)"
  (condition "A.Type == 'Footprint' && A.intersectsArea('LENS_ZONE') && (A.Reference == 'J405' || A.Reference == 'J406' || A.Reference == 'J407' || A.Reference == 'J408' || A.Reference == 'J409' || A.Reference == 'J801' || A.Reference == 'J901' || A.Reference == 'JP1001' || A.Reference == 'JP1002' || A.Reference == 'JP1003' || A.Reference == 'JP1004' || A.Reference == 'JP1101')")
  (constraint disallow footprint))

(rule "lens zone: no tall part (3)"
  (condition "A.Type == 'Footprint' && A.intersectsArea('LENS_ZONE') && (A.Reference == 'JP1501' || A.Reference == 'JP401' || A.Reference == 'L202' || A.Reference == 'L203' || A.Reference == 'L402' || A.Reference == 'SW401' || A.Reference == 'TP1001' || A.Reference == 'TP1002' || A.Reference == 'TP1003' || A.Reference == 'TP1004' || A.Reference == 'TP1005' || A.Reference == 'TP1201')")
  (constraint disallow footprint))

(rule "lens zone: no tall part (4)"
  (condition "A.Type == 'Footprint' && A.intersectsArea('LENS_ZONE') && (A.Reference == 'TP1202' || A.Reference == 'TP1501' || A.Reference == 'TP1502' || A.Reference == 'TP1503' || A.Reference == 'TP401' || A.Reference == 'TP402' || A.Reference == 'TP403' || A.Reference == 'TP701' || A.Reference == 'TP702' || A.Reference == 'TP703' || A.Reference == 'TP704')")
  (constraint disallow footprint))

# The planes join pads solidly (planes.py). Pins that are soldered by hand or by wave get thermal
# reliefs instead, with the gap and spoke width of the zone. Not listed and therefore solid: the
# supply path of the core (J402, J403, J405 to J408, SW401), mounting holes, thermal vias.
(rule "soldered pins: thermal reliefs"
  (condition "A.Pad_Type == 'Through-hole' && (A.memberOfFootprint('J1*') || A.memberOfFootprint('J201') || A.memberOfFootprint('J401') || A.memberOfFootprint('J409') || A.memberOfFootprint('J801') || A.memberOfFootprint('J901') || A.memberOfFootprint('JP*') || A.memberOfFootprint('TP*'))")
  (constraint zone_connection thermal_reliefs))

# JLCPCB: plated component holes need 0.28 mm to tracks, 0.3 mm on inner layers (vias: 0.2 mm)
(rule "PTH pad hole to copper"
  (condition "A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.3mm)))

# The planes have their own clearance (0.125 mm), which replaces that of the net classes
(rule "50 ohm net to plane"
  (condition "A.hasNetclass('50OHM') && B.Type == 'Zone'")
  (constraint clearance (min 0.2mm)))

# Escape of the 0.8 mm BGA: one 0.1 mm track between two pads or two vias.
# Under the package the impedance-controlled nets neck down as well. This rule comes last: it wins.
(rule "BGA escape"
  (condition "A.Type != 'Zone' && A.intersectsArea('BGA_FIELD')")
  (constraint track_width (min 0.09mm) (opt 0.1mm))
  (constraint diff_pair_gap (min 0.09mm) (opt 0.1mm))
  (constraint clearance (min 0.09mm)))
